<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<suite name="OrangeHRM Automation Suite"
       parallel="tests"
       thread-count="2">

    <test name="Login and PIM Tests">
        <parameter name="browser" value="chrome"/>
        <classes>
            <class name="login.LoginTests"/>
            <class name="pim.PIMTests"/>
        </classes>
    </test>

    <test name="Admin and UI Tests">
        <parameter name="browser" value="chrome"/>
        <classes>
            <class name="admin.AdminTests"/>
            <class name="footerandsidebar.FooterAndSidebarTests"/>
        </classes>
    </test>

</suite>
